# Plantilla pública del backend único. Copiar a `.env` (está en .gitignore) y completar. No subir `.env`.
# docker compose lee este archivo; para `mvn spring-boot:run` exporte las mismas variables en la terminal.

# ----- Base de datos única (MySQL 8) -----
MYSQL_DATABASE=plataforma_casos
MYSQL_USER=plataforma
MYSQL_PASSWORD=cambiar-esta-clave
MYSQL_ROOT_PASSWORD=cambiar-esta-clave-root
MYSQL_HOST_PORT=3306

DB_URL=jdbc:mysql://localhost:3306/plataforma_casos?serverTimezone=America/Bogota
DB_USER=plataforma
DB_PASSWORD=cambiar-esta-clave

# ----- Seguridad (módulo 1): un solo token para los seis módulos -----
# Clave HMAC en Base64 de al menos 32 bytes. Se genera con:  openssl rand -base64 32
JWT_SECRETO=
JWT_MINUTOS=60
DOMINIO_INSTITUCIONAL=institucion.edu.co
CORS_ORIGENES=http://localhost:4200

# ----- Correo (módulo 6). Mailpit de docker-compose recibe los correos en http://localhost:8025 -----
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=no-reply@institucion.edu.co

# ----- Sesiones (módulos 3 y 4) -----
ZONA_HORARIA=America/Bogota
POLITICA_INGRESO_TARDIO=mitad
SERVER_PORT=8080
