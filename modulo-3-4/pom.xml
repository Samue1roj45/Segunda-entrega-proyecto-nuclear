<?xml version="1.0" encoding="UTF-8"?>
<!--
  Build de los módulos 3 y 4 (Peter). Se agregó al organizar el repositorio por módulos, porque la rama
  de Peter solo tenía la carpeta src/. Usa las versiones del equipo (Java 21 y Spring Boot 4.1.2) y las
  dependencias que el código importa (Spring Web MVC, JDBC, Validation y MySQL).

  Pendiente de Peter: la clase de arranque (@SpringBootApplication), application.yml, los scripts SQL
  (tablas, triggers y procedimientos) y la clase de apoyo de pruebas com.example.demo.test.Datos.
  Mientras Datos.java no esté en el repositorio las pruebas no compilan, por eso se omiten por defecto;
  cuando exista, ejecutar:  mvn verify -Dmaven.test.skip=false
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.2</version>
        <relativePath/>
    </parent>

    <groupId>com.example</groupId>
    <artifactId>modulo-3-4</artifactId>
    <version>0.1.0</version>
    <name>modulo-3-4</name>
    <description>Proyecto Nuclear - Módulos 3 (asociación, programación y convocatorias) y 4 (participación y control de sesiones)</description>

    <properties>
        <java.version>21</java.version>
        <maven.test.skip>true</maven.test.skip>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-jdbc</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <scope>runtime</scope>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
